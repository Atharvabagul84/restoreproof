# Optional server-only key for live generation in local development.
# Without a key, manual writing and the explicitly selected example still work.
# Never paste a real key into the UI or commit it to Git.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Generation provider: anthropic (default) or groq.
CHISEL_GENERATION_PROVIDER=anthropic
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Hosted demo: production generation for anonymous visitors.
# Only works with CHISEL_GENERATION_PROVIDER=groq, a GROQ_API_KEY and all three
# limit settings below. Anything missing keeps production generation at HTTP 503.
# Limits: 3 drafts per visitor per day, 100 per day in total (lib/demo-limits.ts).
CHISEL_HOSTED_DEMO=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random string used to hash visitor IP addresses; raw addresses are never stored.
CHISEL_VISITOR_SALT=

# Optional team workspace. Follow docs/guides/supabase-setup.md for the new project.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Must match the address used in your browser. Use HTTPS in production.
# The hosted demo also rejects generation requests from any other origin.
CHISEL_APP_URL=http://127.0.0.1:3100
